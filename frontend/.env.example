# Brand shown across the UI
VITE_APP_NAME=Brand
VITE_APP_TAGLINE="Learn Skills. Build Income."
# API origin. Leave empty in dev (Vite proxies /api and /sanctum). Set for production builds.
VITE_API_URL=
# Dev-only proxy target for the Laravel backend
VITE_DEV_BACKEND_URL=http://localhost:8010

# Absolute site URL (robots.txt sitemap line at build time)
VITE_SITE_URL=
