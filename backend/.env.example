APP_NAME="Brand"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- [BRAND] LMS -------------------------------------------------------
APP_TAGLINE="Learn Skills. Build Income."
APP_CURRENCY=INR
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180
SANCTUM_STATEFUL_DOMAINS=localhost:5180,127.0.0.1:5180
SESSION_DOMAIN=localhost
VERIFICATION_EXPIRE_MINUTES=60

# Search (Sail service)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_NO_ANALYTICS=true

# Telescope (registered only when APP_ENV=local)
TELESCOPE_ENABLED=true

# Google login (Socialite) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Avatars: "public" locally, "s3" in production (uses AWS_* below)
AVATAR_DISK=public

# Phone OTP delivery: "log" (dev). An SMS provider driver will be added once chosen.
OTP_DRIVER=log
OTP_TTL_MINUTES=5

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
APP_PORT=8010

# Production super admin (SuperAdminSeeder)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
CONTACT_EMAIL=

# --- Billing (Phase 2) ---------------------------------------------------
# Stripe (non-INR prices) — Laravel Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Razorpay (INR prices)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_DEFAULT_CURRENCY=INR
BILLING_GRACE_DAYS=3
# Seller details printed on invoices (GST/VAT)
BILLING_SELLER_NAME="${APP_NAME}"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_ID=
BILLING_SELLER_EMAIL=
INVOICE_DISK=local
INVOICE_PREFIX=INV

# --- Courses & video (Phase 3) -------------------------------------------
# bunny in production; demo plays a public test stream (local only, unprotected)
VIDEO_DRIVER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=

# Live classes — Zoom (Server-to-Server OAuth app + Meeting SDK app in the SAME Zoom account).
# Cloud recordings and participant reports need a paid Zoom plan (Pro or higher).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_WEBHOOK_SECRET=
ZOOM_AUTO_RECORDING=cloud

# Instructor earnings
EARNINGS_POOL_PERCENT=50
EARNINGS_DEFAULT_SHARE_PERCENT=70
EARNINGS_MAX_SECONDS_PER_USER_DAY=14400

# Affiliates & referrals
AFFILIATE_COOKIE_DAYS=60
AFFILIATE_ATTRIBUTION=last_touch
AFFILIATE_RECURRING_MONTHS=12
AFFILIATE_INCLUDE_COURSE_SALES=true
AFFILIATE_LEVEL2_ENABLED=false
AFFILIATE_LEVEL2_PERCENT=5
AFFILIATE_HOLD_DAYS=14
AFFILIATE_MIN_PAYOUT_INR=100000
AFFILIATE_MIN_PAYOUT_USD=2500
STUDENT_REFERRALS_ENABLED=true
STUDENT_REFERRAL_REWARD=days
STUDENT_REFERRAL_DAYS=30

# Notifications (Phase 8)
# Mail: MAIL_MAILER=mailgun (+ MAILGUN_DOMAIN, MAILGUN_SECRET, MAILGUN_ENDPOINT) or ses (needs aws/aws-sdk-php)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en
SMS_DRIVER=log
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FCM_PROJECT_ID=
FCM_CREDENTIALS=
OTP_CHANNEL=sms
VIDEO_PLAYBACK_TTL_MIN=900
VIDEO_PLAYBACK_TTL_MAX=14400
COURSE_FILES_DISK=local
COURSE_THUMBNAILS_DISK=public
SCOUT_QUEUE=true

# Admin & analytics (Phase 9)
ANALYTICS_CACHE_STORE=
ANALYTICS_CACHE_TTL=60
ANALYTICS_TIMEZONE=Asia/Kolkata
# Optional marketing analytics (also editable in Admin → Settings → Tracking)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v26.0
ACTIVITY_LOGGER_ENABLED=true

# Security & scale (Phase 10)
CAPTCHA_DRIVER=none            # turnstile | none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
MAX_DEVICES=2
UPLOAD_SCAN_DRIVER=none        # clamav | none
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
UPLOAD_SCAN_FAIL_CLOSED=true
API_RATE_LIMIT=120
ADMIN_RATE_LIMIT=300
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
GOOGLE_MOBILE_CLIENT_IDS=      # comma-separated OAuth client ids of the Android/iOS apps
TRUSTED_PROXIES=127.0.0.1      # load balancer / CDN ranges ("*" behind an ALB)
CATALOG_CACHE_STORE=           # redis in production
DB_READ_HOST=                  # comma-separated read replicas (mysql)
DB_PERSISTENT=false            # true only without a connection pooler
REDIS_SCHEME=tcp               # unix + REDIS_PATH for a local socket
REDIS_PATH=
REDIS_PERSISTENT=false
HORIZON_CRITICAL_MAX=10
HORIZON_MESSAGING_MAX=20
HORIZON_MEDIA_MAX=2
BILLING_SANDBOX_GATEWAY=false  # load tests only; ignored in production
BILLING_SANDBOX_LATENCY_MS=150
